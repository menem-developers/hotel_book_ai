# Application Configuration
APP_NAME=Hotel Booking AI Assistant
PORT=8000
HOST=0.0.0.0
DEBUG=False

# MongoDB Database Connection
# When running on Ubuntu / Cloud:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.a1bur.mongodb.net/?compressors=zlib
MONGODB_DB_NAME=hotel_booking

# Ollama LLM Configuration
# When running app inside Docker and Ollama on Ubuntu host:
OLLAMA_HOST=http://host.docker.internal:11434
# If running app directly on Ubuntu (without Docker):
# OLLAMA_HOST=http://127.0.0.1:11434

OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=45.0

# Natural Neural Text-to-Speech (TTS) Voice
# Female options: en-US-AriaNeural (default), en-US-JennyNeural, en-US-AvaNeural
TTS_VOICE=en-US-AriaNeural
